---
/*
 * 価格ページの共通部品（/pricing.html・/en/pricing.html）。
 * 購入ボタンは POST /api/checkout（{ lookup_key, lang }）を呼び、返ってきた Stripe の Checkout 画面へ移る。
 * Checkout の「戻る」の戻り先（worker/checkout.js の cancel_url）もこのページ。
 * 価格の表示は Stripe 側の金額（サンドボックスは worker/plans.js・Stripe/stripe-implementation-brief.md の表）と手でそろえる。
 * 通貨は言語で決まる（日本語=JPY、英語=USD）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { legacyCss } from '../../build/legacy-tool.mjs';
import { pathFor } from '../i18n/utils.mjs';
import { iconSvg } from '../i18n/icons.mjs';

interface Props { locale: 'ja' | 'en' }
const { locale } = Astro.props;
const css = legacyCss('about.html');

// ツールごとの有料機能。実際の判定（shared/export-plan.js の FEATURES、shared/video-export.js の画質・透過、
// 各ツールの getPaidFeatures）とそろえること。有料機能を足したり外したりしたら、ここも直す。
// path は src/i18n/routes.mjs の各ツールの LP。
const F_JA = {
  no_watermark: { icon: 'noWatermark', name: '透かしなしの書き出し', desc: '動画に入る「GraphRace Studio」の透かしを消して書き出せます。' },
  hd_max: { icon: 'sparkle', name: '最高画質', desc: '標準の2倍の解像度で書き出せます。大きな画面での再生や、編集での拡大に。' },
  hd_1080: { icon: 'hd', name: '高画質（1080p）', desc: 'フルHD（1080p）で書き出せます。描画ごと高解像度にするので、引き伸ばしではありません。' },
  transparent: { icon: 'transparent', name: '透過書き出し', desc: '背景を透明にした MOV・PNG連番で書き出せます。動画編集ソフトで映像に重ねられます。' },
  rounded_bar: { icon: 'pill', name: '角丸バー', desc: 'バーの端を丸くした、やわらかい見た目にできます。' },
  image_right: { icon: 'image', name: '画像をバーの右に置く', desc: '国旗やロゴなどの画像を、バーの右（数字の左）に置けます。' },
  fanfare: { icon: 'music', name: 'ファンファーレ', desc: 'スタート前のカウントダウンの代わりに、ファンファーレを流せます。' },
  sound: { icon: 'sound', name: 'サウンド（歓声・蹄の音）', desc: 'レース中の歓声や蹄の音を、書き出す動画に入れられます。' },
};
const F_EN = {
  no_watermark: { icon: 'noWatermark', name: 'No watermark', desc: 'Export without the “GraphRace Studio” watermark.' },
  hd_max: { icon: 'sparkle', name: 'Maximum quality', desc: 'Export at twice the standard resolution — great for big screens or zooming in while editing.' },
  hd_1080: { icon: 'hd', name: 'High quality (1080p)', desc: 'Export in Full HD (1080p). The scene is rendered at full resolution, not upscaled.' },
  transparent: { icon: 'transparent', name: 'Transparent export', desc: 'Export MOV or a PNG sequence with a clear background, ready to layer over footage in your editor.' },
  rounded_bar: { icon: 'pill', name: 'Rounded bars', desc: 'Give your bars soft, rounded ends.' },
  image_right: { icon: 'image', name: 'Images to the right of bars', desc: 'Place flags, logos and other images to the right of each bar (left of the number).' },
  fanfare: { icon: 'music', name: 'Fanfare', desc: 'Play a fanfare before the start instead of the countdown.' },
  sound: { icon: 'sound', name: 'Sound (crowd and hoofbeats)', desc: 'Add crowd cheers and hoofbeats to your exported video.' },
};
const TOOL_DEFS = [
  { id: 'bar-chart-race', icon: 'bars', ja: 'バーチャートレース', en: 'Bar Chart Race', f: ['no_watermark', 'hd_max', 'transparent', 'rounded_bar', 'image_right'] },
  { id: 'line-chart-race', icon: 'line', ja: '線グラフレース', en: 'Line Chart Race', f: ['no_watermark', 'hd_max', 'transparent'] },
  { id: 'pie-chart-race', icon: 'pie', ja: '円グラフレース', en: 'Pie Chart Race', f: ['no_watermark', 'hd_max', 'transparent'] },
  { id: 'horse-race', icon: 'horse', ja: '格付けダービー', en: 'Ranking Derby', f: ['no_watermark', 'hd_1080', 'fanfare', 'sound'] },
];
const toolsFor = (lang, F) => TOOL_DEFS.map((t) => ({
  id: t.id, icon: t.icon, name: t[lang], href: pathFor(t.id, lang), features: t.f.map((k) => F[k]),
}));
const TOOLS_JA = toolsFor('ja', F_JA);
const TOOLS_EN = toolsFor('en', F_EN);

const TEXT = {
  ja: {
    title: '料金プラン｜GraphRace Studio',
    description: 'GraphRace Studio の料金プラン。透かしなし・高画質・透過書き出しなどが使える 7日パス・月額・年額プランを、必要な期間だけ選べます。',
    heading: '料金プラン',
    saleBanner: 'ブラックフライデーセール：全プラン30%OFF（11/30 23:59まで）',
    lead: 'ツールは無料で試せます。透かしなしの書き出しや高画質・透過書き出しなどを使いたいときだけ、プランをお選びください。どのプランも使える機能は同じです。',
    crumbs: [{ name: 'ホーム', href: '/' }, { name: '料金プラン' }],
    tagline: 'データビジュアライゼーションツール',
    featuresEyebrow: 'FEATURES',
    featuresTitle: '有料プランでできること',
    featuresSub: 'どのプランでも、使える機能は同じです。ツールを選ぶと、そのツールで使える有料機能が表示されます。',
    openTool: 'ツールを開く',
    freeTitle: 'すべての機能が無料のツール',
    freeNote: '次のツールは、有料プランがなくても透かしなし・すべての機能を使えます。',
    tools: TOOLS_JA,
    freeTools: ['トーナメント表', 'ランキング動画', 'あみだくじ'],
    plans: [
      { key: 'pass7', lookup: 'grs_pass7', name: '7日パス', fit: '結婚式・社内イベントなど、1回だけ使いたい方に', price: '¥980', sale: '¥686', saleNote: '', unit: '（1回のお支払い）', note: '購入から7日間使えます。自動更新はありません。', cta: '購入する', ctaLabel: '7日パスを購入する' },
      { key: 'monthly', lookup: 'grs_monthly', name: '月額プラン', fit: '数か月だけ集中して作りたい方に', price: '¥1,580', sale: '¥1,106', saleNote: '初月のみ。2か月目から¥1,580', unit: '／月', note: '毎月自動で更新されます。いつでも解約できます。', cta: '購入する', ctaLabel: '月額プランを購入する' },
      { key: 'yearly', lookup: 'grs_yearly', name: '年額プラン', fit: '動画を作り続ける方に', price: '¥3,480', sale: '¥2,436', saleNote: '初年のみ。2年目から¥3,480', unit: '／年', note: '月あたり約290円。毎年自動で更新されます。いつでも解約できます。', cta: '購入する', ctaLabel: '年額プランを購入する', badge: 'おすすめ' },
    ],
    taxNote: '表示は税込です。',
    trustNote: 'アカウント登録は不要です。お支払いは、世界中で使われている決済サービス Stripe の画面で行います。カード情報が当サイトに保存されることはありません。',
    faqEyebrow: 'FAQ',
    faqTitle: 'よくある質問',
    faqSub: '購入・ライセンスキー・解約について',
    faq: [
      { q: 'ライセンスキーはどう届きますか？', a: 'お支払いが済むと購入完了ページにキーが表示され、同じ内容をメールでもお送りします。ツールで書き出すときに表示される案内の「ライセンスキーをお持ちの方」を開き、キーを貼り付けてください。' },
      { q: '7日パスは自動で更新されますか？', a: 'いいえ。7日パスは1回のお支払いで、7日たつと自動的に終了します。続けて使う場合は、もう一度購入するか月額・年額プランをお選びください。' },
      { q: '月額・年額プランの更新日と解約はどうなりますか？', a: '購入日と同じ日に、毎月（年額は毎年）自動で更新されます。解約・お支払い方法の変更は Link（link.com）から行えます。解約しても、お支払い済みの期間の終わりまでは使えます。' },
      { q: 'カードの明細にはどう表示されますか？', a: '「LINK.COM*」と表示されます。領収書は Link から届きます。' },
      { q: '領収書はもらえますか？', a: 'お支払いが済むと、Link から領収書（レシート）がメールで届きます。経費精算などにお使いください。届かない場合や再発行が必要な場合は、お問い合わせください。' },
      { q: '何台の端末で使えますか？', a: '現在、端末の台数に制限はありません。ライセンスキーはご自身の範囲でお使いください。' },
      { q: '返金はできますか？', a: 'デジタルコンテンツの性質上、お客様のご都合による返金・キャンセルはお受けしていません。ただし、二重にお支払いいただいた場合や、不具合でご利用いただけない場合は、お問い合わせください。確認のうえ返金します。返金したライセンスキーは使えなくなります。' },
    ],
    contact: 'ご不明な点は',
    contactLink: 'お問い合わせ',
    contactEnd: 'ページからご連絡ください。',
    termsLabel: '利用規約', privacyLabel: 'プライバシーポリシー', tokushohoLabel: '特定商取引法に基づく表記',
  },
  en: {
    title: 'Pricing | GraphRace Studio',
    description: 'GraphRace Studio pricing. Choose a 7-day pass, monthly or yearly plan to export without a watermark, in high quality, or with a transparent background.',
    heading: 'Pricing',
    lead: 'You can try every tool for free. Pick a plan only when you want to export without a watermark, in higher quality, or with a transparent background. All plans include the same features.',
    saleBanner: 'Black Friday sale: 30% off every plan (ends Nov 30, 23:59 JST)',
    crumbs: [{ name: 'Home', href: '/en/' }, { name: 'Pricing' }],
    tagline: 'Data visualization tools',
    featuresEyebrow: 'FEATURES',
    featuresTitle: 'What paid plans unlock',
    featuresSub: 'Every plan includes the same features. Pick a tool to see what you unlock in it.',
    openTool: 'Open the tool',
    freeTitle: 'Tools that are completely free',
    freeNote: 'These tools have no watermark and every feature is free — no plan needed.',
    tools: TOOLS_EN,
    freeTools: ['Tournament Bracket', 'Ranking Video'],
    plans: [
      { key: 'pass7', lookup: 'grs_pass7', name: '7-Day Pass', fit: 'For a one-off event, class or presentation', price: '$5.99', sale: '$4.19', saleNote: '', unit: '(one-time payment)', note: 'Works for 7 days from purchase. It does not renew automatically.', cta: 'Buy now', ctaLabel: 'Buy the 7-Day Pass' },
      { key: 'monthly', lookup: 'grs_monthly', name: 'Monthly plan', fit: 'For a project that runs a few months', price: '$12.99', sale: '$9.09', saleNote: 'First month only, then $12.99/month', unit: '/ month', note: 'Renews automatically every month. Cancel anytime.', cta: 'Buy now', ctaLabel: 'Buy the monthly plan' },
      { key: 'yearly', lookup: 'grs_yearly', name: 'Yearly plan', fit: 'For creators who publish regularly', price: '$29.99', sale: '$20.99', saleNote: 'First year only, then $29.99/year', unit: '/ year', note: 'About $2.50 a month. Renews automatically every year. Cancel anytime.', cta: 'Buy now', ctaLabel: 'Buy the yearly plan', badge: 'Best value' },
    ],
    taxNote: 'Prices are shown in USD.',
    trustNote: 'No account needed. You pay on the secure checkout page of Stripe, a payment service trusted worldwide. Your card details are never stored on this site.',
    faqEyebrow: 'FAQ',
    faqTitle: 'Frequently asked questions',
    faqSub: 'Buying, license keys and cancelling',
    faq: [
      { q: 'How do I get my license key?', a: 'After you pay, the key appears on the confirmation page and we also email it to you. When you export in a tool, open “I have a license key” in the dialog and paste the key.' },
      { q: 'Does the 7-Day Pass renew automatically?', a: 'No. It is a one-time payment and ends after 7 days. To keep going, buy another pass or choose the monthly or yearly plan.' },
      { q: 'How do renewals and cancellation work for monthly and yearly plans?', a: 'Plans renew automatically on the same day each month (or year) as your purchase. You can cancel or update your payment method through Link (link.com). After you cancel, you can keep using the plan until the end of the period you have paid for.' },
      { q: 'What will appear on my card statement?', a: 'It will show “LINK.COM*”. Receipts are sent by Link.' },
      { q: 'Can I get a receipt?', a: 'Yes. Link emails you a receipt after each payment. If you did not receive it or need another copy, please contact us.' },
      { q: 'How many devices can I use it on?', a: 'There is currently no limit on the number of devices. Please use your key for your own work.' },
      { q: 'Can I get a refund?', a: 'Because this is digital content, we do not offer refunds or cancellations for reasons of personal convenience. If you were charged twice, or you cannot use the Service because of a defect, please contact us. We will review it and refund you if appropriate. A refunded license key stops working.' },
    ],
    contact: 'Questions? Please ',
    contactLink: 'contact us',
    contactEnd: '.',
    termsLabel: 'Terms of Service', privacyLabel: 'Privacy Policy',
  },
}[locale];

// ボタンを押したときの文言（本文に波括弧を書かないよう、属性で渡す）
const I18N = {
  ja: { loading: '決済画面へ移動しています…', error: '決済画面を開けませんでした。時間をおいて、もう一度お試しください。' },
  en: { loading: 'Taking you to checkout…', error: 'We could not open the checkout page. Please try again in a moment.' },
}[locale];

const PREFIX = locale === 'en' ? '/en' : '';
const ABOUT_HREF = `${PREFIX}/about.html`;
const TERMS_HREF = `${PREFIX}/terms.html`;
const PRIVACY_HREF = `${PREFIX}/privacy.html`;
---
<BaseLayout pageId="pricing" title={TEXT.title} description={TEXT.description}>
  <Fragment slot="head">
    <style is:inline set:html={css}></style>
    <style is:inline>
      .pricing-lead { margin: 0 0 28px; }
      .pricing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0 0 12px; }
      .plan-card { position: relative; display: flex; flex-direction: column; padding: 24px 20px 20px; border: 1px solid var(--panel-border); border-radius: 14px; background: #fff; }
      .plan-card.is-featured { border: 2px solid var(--accent); padding: 23px 19px 19px; }
      .plan-badge { position: absolute; top: -12px; left: 16px; padding: 2px 12px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 12px; font-weight: 700; }
      .plan-name { margin: 0 0 8px; font-size: 1.05rem; font-weight: 700; color: var(--text-strong); }
      .plan-price { margin: 0 0 4px; font-size: 2rem; font-weight: 700; line-height: 1.2; color: var(--text-strong); }
      .plan-unit { font-size: 0.85rem; font-weight: 400; color: var(--text-muted); margin-left: 4px; }
      .content-block .sale-banner { margin: 0 0 20px; border: 0; padding: 12px 16px; border-radius: 10px; background: #111; color: #fff !important; font-weight: 700; text-align: center; opacity: 1; }
      .plan-was { display: block; font-size: 1rem; font-weight: 400; line-height: 1.4; color: var(--text-muted); }
      .plan-off { display: inline-block; margin-left: 8px; padding: 1px 8px; border-radius: 999px; background: #e11d48; color: #fff; font-size: 0.78rem; font-weight: 800; line-height: 1.5; vertical-align: 2px; }
      /* セールバナー: 光が横に流れる＋ゆっくり明滅（動きを減らす設定の人には止める） */
      .content-block .sale-banner { position: relative; overflow: hidden; background: linear-gradient(90deg, #111 0%, #3b0a1e 50%, #111 100%); background-size: 200% 100%; animation: sale-bg 6s ease-in-out infinite; box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.5); }
      .content-block .sale-banner::after { content: ''; position: absolute; top: 0; left: -40%; width: 30%; height: 100%; background: linear-gradient(100deg, transparent, rgba(255,255,255,0.35), transparent); transform: skewX(-20deg); animation: sale-shine 3s ease-in-out infinite; pointer-events: none; }
      .content-block .sale-banner { animation: sale-bg 6s ease-in-out infinite, sale-pulse 2s ease-out infinite; }
      @keyframes sale-bg { 0%, 100% { background-position: 0% 0; } 50% { background-position: 100% 0; } }
      @keyframes sale-shine { 0% { left: -40%; } 60%, 100% { left: 120%; } }
      @keyframes sale-pulse { 0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.55); } 100% { box-shadow: 0 0 0 10px rgba(225, 29, 72, 0); } }
      @media (prefers-reduced-motion: reduce) { .content-block .sale-banner, .content-block .sale-banner::after { animation: none; } }
      .plan-was[hidden], .sale-only[hidden] { display: none; }
      /* カード内の各行（名前・説明・価格・注記・説明文・ボタン）を3枚で横にそろえる */
      @supports (grid-template-rows: subgrid) {
        .plan-card { display: grid; grid-template-rows: subgrid; grid-row: span 6; row-gap: 0; align-content: start; }
        .plan-card > .plan-buy { align-self: end; }
      }
      .content-block .plan-sale-note { margin: 0; padding: 0; font-size: 0.82rem; font-weight: 700; color: #b42318; }
      .plan-note { flex: 1; margin: 8px 0 16px; font-size: 0.9rem; color: var(--text-muted); }
      .plan-buy { font: inherit; font-weight: 700; cursor: pointer; padding: 12px 16px; border: 0; border-radius: 10px; background: var(--accent); color: #fff; }
      .plan-buy:hover { filter: brightness(1.08); }
      .plan-buy:disabled { opacity: 0.6; cursor: progress; }
      .pricing-status { min-height: 1.6em; margin: 8px 0 0; color: #b42318; font-weight: 600; }
      .pricing-features { margin: 0 0 8px; padding-left: 1.4em; }
      .faq-item { margin: 0 0 18px; }
      /* 共通の .content-block h2 / p の装飾がカードの中に効かないようにする */
      .content-block .plan-name { margin: 0 0 8px; padding: 0; border: 0; font-size: 1.15rem; }
      .content-block .plan-price { margin: 4px 0 4px; padding: 0; font-size: 2rem; font-weight: 800; line-height: 1.2; color: var(--text-strong); }
      .content-block .plan-fit { margin: 0 0 10px; padding: 0; font-size: 0.86rem; font-weight: 700; line-height: 1.5; color: var(--accent); }
      .content-block .pricing-notes { margin: 0 0 32px; }
      .content-block .pricing-notes p { margin: 0; padding: 0; font-size: 0.88rem; line-height: 1.7; color: var(--text-muted); }
      .content-block .plan-note { padding: 0; font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); }
      .plan-buy { white-space: nowrap; font-size: 1rem; }
      .plan-unit { white-space: nowrap; display: inline-block; }

      /* セクション見出し（トップページの .section-title に合わせる） */
      .pricing-section { margin-top: 64px; }
      .sec-head { text-align: center; margin: 0 0 28px; }
      .sec-eyebrow { display: inline-block; padding: 3px 12px; border-radius: 999px; background: var(--accent-soft, rgba(108, 92, 231, 0.1)); color: var(--accent-strong, var(--accent)); font-size: 12px; font-weight: 800; letter-spacing: 0.12em; }
      .content-block h2.sec-title { margin: 10px 0 8px; padding: 0; border: 0; font-size: clamp(22px, 3vw, 28px); font-weight: 800; color: var(--text-strong); }
      .content-block .sec-sub { margin: 0 auto; padding: 0; max-width: 560px; font-size: 14px; color: var(--text-muted); }

      /* ツールのタブ（スマホでは横にスクロール） */
      .tool-tabs { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px; margin: 0 0 16px; scrollbar-width: thin; justify-content: center; }
      .tool-tab { flex: none; display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 14px; font-weight: 700; white-space: nowrap; cursor: pointer; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--panel-border); background: #fff; color: var(--text-main); transition: background 0.15s, color 0.15s, border-color 0.15s; }
      .tool-tab:hover { border-color: var(--accent); color: var(--accent); }
      .tool-tab[aria-selected="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
      .tool-tab-icon { display: inline-flex; font-size: 17px; }
      .free-title-icon { display: inline-flex; vertical-align: -0.2em; margin-right: 6px; font-size: 1.25em; color: var(--accent); }
      @media (max-width: 760px) { .tool-tabs { justify-content: flex-start; } }

      /* 機能カード */
      .tool-panel { border: 1px solid var(--panel-border); border-radius: 16px; background: var(--panel-surface, #fafafe); padding: 20px; }
      .feature-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
      .feature-card { background: #fff; border: 1px solid var(--panel-border); border-radius: 12px; padding: 16px; }
      .feature-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; background: var(--accent-soft, rgba(108, 92, 231, 0.1)); color: var(--accent); font-size: 22px; margin-bottom: 10px; }
      .content-block .feature-name { margin: 0 0 4px; font-size: 15px; font-weight: 700; color: var(--text-strong); }
      .content-block .feature-desc { margin: 0; padding: 0; font-size: 13px; line-height: 1.7; color: var(--text-muted); }
      .content-block .tool-open { margin: 14px 0 0; padding: 0; text-align: right; font-size: 14px; }
      .tool-open a { color: var(--accent); font-weight: 700; text-decoration: none; }
      .tool-open a:hover { text-decoration: underline; }

      .free-box { margin-top: 16px; padding: 16px 20px; border-radius: 12px; border: 1px dashed var(--panel-border); }
      .content-block .free-title { margin: 0 0 2px; padding: 0; font-weight: 700; color: var(--text-strong); }
      .content-block .free-note { margin: 0 0 8px; padding: 0; font-size: 13px; color: var(--text-muted); }
      .content-block .free-tools { margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
      .free-chip { padding: 3px 10px; border-radius: 999px; background: var(--accent-soft, rgba(108, 92, 231, 0.1)); font-size: 13px; font-weight: 700; color: var(--text-strong); }

      /* よくある質問（開閉式） */
      .faq-list { display: grid; gap: 10px; margin-bottom: 24px; }
      .faq-item { border: 1px solid var(--panel-border); border-radius: 12px; background: #fff; }
      .faq-item summary { cursor: pointer; list-style: none; position: relative; padding: 14px 44px 14px 16px; font-weight: 700; color: var(--text-strong); }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::before { content: "Q"; display: inline-block; margin-right: 10px; color: var(--accent); font-weight: 800; }
      .faq-item summary::after { content: "+"; position: absolute; right: 16px; top: 50%; transform: translateY(-50%); font-size: 20px; color: var(--accent); }
      .faq-item[open] summary::after { content: "−"; }
      .content-block .faq-item p { margin: 0; padding: 0 16px 16px 38px; font-size: 14px; }
      @media (max-width: 760px) { .pricing-grid { grid-template-columns: 1fr; } }
    </style>
  </Fragment>

  <SiteHeader pageId="pricing" locale={locale} />

  <main class="wrap">
    <h1 class="page-title">{TEXT.heading}</h1>
    <div class="content-block" id="pricing" data-lang={locale} data-i18n={JSON.stringify(I18N)}>
      <section>
        <p class="sale-banner" id="sale-banner" hidden>{TEXT.saleBanner}</p>
        <p class="pricing-lead">{TEXT.lead}</p>

        <div class="pricing-grid">
          {TEXT.plans.map((p) => (
            <div class={`plan-card${p.badge ? ' is-featured' : ''}`}>
              {p.badge && <span class="plan-badge">{p.badge}</span>}
              <h2 class="plan-name">{p.name}</h2>
              <p class="plan-fit">{p.fit}</p>
              <p class="plan-price"><span class="plan-was sale-only" hidden><s>{p.price}</s><span class="plan-off">30%OFF</span></span><span class="sale-only" hidden>{p.sale}</span><span class="sale-off">{p.price}</span><span class="plan-unit">{p.unit}</span></p>
              <p class="plan-sale-note sale-only" hidden>{p.saleNote}</p>
              <p class="plan-note">{p.note}</p>
              <button
                type="button"
                class="plan-buy"
                aria-label={p.ctaLabel}
                data-lookup={p.lookup}
                data-track="checkout_start"
                data-track-plan={p.key}
              >{p.cta}</button>
            </div>
          ))}
        </div>
        <p class="pricing-status" id="pricing-status" role="status" aria-live="polite"></p>
        <div class="pricing-notes">
          <p>{TEXT.trustNote}</p>
          <p>{TEXT.taxNote}</p>
        </div>
      </section>

      <section class="pricing-section">
        <div class="sec-head">
          <span class="sec-eyebrow">{TEXT.featuresEyebrow}</span>
          <h2 class="sec-title">{TEXT.featuresTitle}</h2>
          <p class="sec-sub">{TEXT.featuresSub}</p>
        </div>

        <div class="tool-tabs" role="tablist" aria-label={TEXT.featuresTitle}>
          {TEXT.tools.map((t, i) => (
            <button
              type="button"
              class="tool-tab"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-track="pricing_tool_select"
              data-track-target-tool={t.id}
            ><span class="tool-tab-icon" aria-hidden="true" set:html={iconSvg(t.icon)} />{t.name}</button>
          ))}
        </div>

        {TEXT.tools.map((t, i) => (
          <div class="tool-panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
            <ul class="feature-grid">
              {t.features.map((f) => (
                <li class="feature-card">
                  <span class="feature-icon" aria-hidden="true" set:html={iconSvg(f.icon)} />
                  <h3 class="feature-name">{f.name}</h3>
                  <p class="feature-desc">{f.desc}</p>
                </li>
              ))}
            </ul>
            {t.href && <p class="tool-open"><a href={t.href}>{TEXT.openTool} →</a></p>}
          </div>
        ))}

        <div class="free-box">
          <p class="free-title"><span class="free-title-icon" aria-hidden="true" set:html={iconSvg('gift')} />{TEXT.freeTitle}</p>
          <p class="free-note">{TEXT.freeNote}</p>
          <p class="free-tools">{TEXT.freeTools.map((n) => <span class="free-chip">{n}</span>)}</p>
        </div>
      </section>

      <section class="pricing-section">
        <div class="sec-head">
          <span class="sec-eyebrow">{TEXT.faqEyebrow}</span>
          <h2 class="sec-title">{TEXT.faqTitle}</h2>
          <p class="sec-sub">{TEXT.faqSub}</p>
        </div>
        <div class="faq-list">
          {TEXT.faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p>{TEXT.contact}<a href={ABOUT_HREF}>{TEXT.contactLink}</a>{TEXT.contactEnd}</p>
        <p><a href={TERMS_HREF}>{TEXT.termsLabel}</a> / <a href={PRIVACY_HREF}>{TEXT.privacyLabel}</a>{TEXT.tokushohoLabel && <Fragment> / <a href="/tokushoho.html">{TEXT.tokushohoLabel}</a></Fragment>}</p>
      </section>
    </div>
  </main>

  <SiteFooter locale={locale} crumbs={TEXT.crumbs} tagline={TEXT.tagline} />

  <script is:inline>
    (function () {
      var root = document.getElementById('pricing');
      var T = JSON.parse(root.getAttribute('data-i18n'));
      var lang = root.getAttribute('data-lang');
      var statusEl = document.getElementById('pricing-status');
      var buttons = Array.prototype.slice.call(root.querySelectorAll('.plan-buy'));

      // ブラックフライデーセール（worker/sale.js と同じ期間）。preview・localhost では ?sale=1 で期間外でも表示・適用
      var SALE_START = Date.parse('2026-11-22T00:00:00+09:00');
      var SALE_END = Date.parse('2026-12-01T00:00:00+09:00');
      var host = location.hostname;
      var testHost = host === 'localhost' || host === '127.0.0.1' || host.indexOf('preview-') === 0;
      var forceSale = testHost && /[?&]sale=1(&|$)/.test(location.search);
      var now = Date.now();
      var saleOn = forceSale || (now >= SALE_START && now < SALE_END);
      if (saleOn) {
        document.getElementById('sale-banner').hidden = false;
        Array.prototype.forEach.call(root.querySelectorAll('.sale-only'), function (el) { el.hidden = false; });
        Array.prototype.forEach.call(root.querySelectorAll('.sale-off'), function (el) { el.hidden = true; });
      }

      // どこから料金ページへ来たか（同じサイト内の直前のページ。URL には何も足さない）。
      // 言語を切り替えても消えないよう sessionStorage に持つ。個人情報は入らない（ページの種類だけ）
      var SOURCE_RE = /^[a-z0-9-]{1,40}$/;
      function readSource() {
        var s = '';
        try { s = sessionStorage.getItem('grs_buy_from') || ''; } catch (e) {}
        if (!s && document.referrer) {
          try {
            var r = new URL(document.referrer);
            if (r.origin === location.origin) {
              var seg = r.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '').split('/')[1] || 'home';
              seg = seg.replace(/\.html$/, '');
              if (SOURCE_RE.test(seg) && seg !== 'pricing') s = seg;
            }
          } catch (e) {}
        }
        if (!SOURCE_RE.test(s)) s = '';
        try { if (s) sessionStorage.setItem('grs_buy_from', s); } catch (e) {}
        return s;
      }
      var source = readSource();

      function setBusy(busy) {
        buttons.forEach(function (b) { b.disabled = busy; });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          statusEl.style.color = '';
          statusEl.textContent = T.loading;
          setBusy(true);
          fetch('/api/checkout', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ lookup_key: btn.getAttribute('data-lookup'), lang: lang, source: source, force_sale: forceSale }),
          })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, d: d }; }); })
            .then(function (r) {
              if (r.ok && r.d && r.d.url) { location.href = r.d.url; return; }
              throw new Error('checkout_failed');
            })
            .catch(function () {
              statusEl.style.color = '#b42318';
              statusEl.textContent = T.error;
              setBusy(false);
            });
        });
      });

      // ツールのタブ切り替え（左右キーでも移動できる）
      var tabs = Array.prototype.slice.call(root.querySelectorAll('.tool-tab'));
      function selectTab(tab, focus) {
        tabs.forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        });
        if (focus) tab.focus();
        tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () { selectTab(tab); });
        tab.addEventListener('keydown', function (e) {
          var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          e.preventDefault();
          selectTab(tabs[(i + d + tabs.length) % tabs.length], true);
        });
      });

      // Stripe の決済画面からブラウザの「戻る」で戻ったとき、ボタンが押せない状態で残らないようにする
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) { statusEl.textContent = ''; setBusy(false); }
      });
    })();
  </script>
</BaseLayout>
