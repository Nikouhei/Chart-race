---
// 言語切替。同じページの他言語版があればそこへ、無ければその言語のトップへ。
// 自動リダイレクトはしない（押したときだけ移動）。
import { LOCALES } from '../i18n/config.mjs';
import { pathFor, homePath, t, includeDrafts } from '../i18n/utils.mjs';

interface Props { pageId: string; locale: string }
const { pageId, locale } = Astro.props;
const drafts = includeDrafts();

const options = Object.keys(LOCALES)
  .map((loc) => {
    const own = pathFor(pageId, loc, { drafts });
    const home = pathFor('home', loc, { drafts }) ? homePath(loc) : null;
    return { loc, href: own || home, ...LOCALES[loc] };
  })
  .filter((o) => o.href);
const current = LOCALES[locale];
---
{options.length > 1 && (
  <details class="lang-switch">
    <summary aria-label={t(locale, 'lang.switcherLabel')}>
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18Zm-8.5 9h17M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3Z"/></svg>
      <span>{current.short}</span>
    </summary>
    <ul>
      {options.map((o) => (
        <li>
          {o.loc === locale
            ? <span class="is-current" aria-current="true">{o.label}</span>
            : <a href={o.href} hreflang={o.hreflang} lang={o.htmlLang} data-track="language_switch">{o.label}</a>}
        </li>
      ))}
    </ul>
  </details>
)}

<style>
  .lang-switch { position: relative; flex-shrink: 0; margin-left: 8px; font-size: 13px; }
  .lang-switch summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
    padding: 7px 12px; border-radius: 20px; border: 1px solid var(--panel-border);
    color: var(--text-muted); font-weight: 600; background: rgba(255,255,255,0.7);
    transition: color .2s ease, border-color .2s ease;
  }
  .lang-switch summary::-webkit-details-marker { display: none; }
  .lang-switch summary:hover, .lang-switch[open] summary { color: var(--accent); border-color: var(--accent); }
  .lang-switch ul {
    position: absolute; right: 0; top: calc(100% + 6px); margin: 0; padding: 6px; list-style: none;
    min-width: 140px; background: #fff; border: 1px solid var(--panel-border); border-radius: 12px;
    box-shadow: 0 8px 24px rgba(16,18,22,0.12); z-index: 1100;
  }
  .lang-switch li a, .lang-switch li span { display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--text-main); }
  .lang-switch li a:hover { background: var(--accent-soft); color: var(--accent-strong); }
  .lang-switch .is-current { color: var(--accent-strong); font-weight: 700; }
  @media (max-width: 768px) {
    .lang-switch { position: absolute; top: 10px; right: 16px; margin: 0; }
    .lang-switch summary { padding: 5px 10px; font-size: 12px; }
  }
</style>
