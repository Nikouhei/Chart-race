---
import { FOOTER_LINKS } from '../i18n/routes.mjs';
import { pathFor, homePath, t, includeDrafts } from '../i18n/utils.mjs';

// crumbs: パンくず（最後が現在のページ）。省略時は「ホーム」だけ。null ならパンくずを出さない
// tagline: コピーライトの後ろに付ける説明（省略時は辞書の footer.copyright）
interface Crumb { name: string; href?: string }
interface Props { locale: string; crumbs?: Crumb[] | null; tagline?: string }
const { locale, tagline } = Astro.props;
const crumbs: Crumb[] | null = Astro.props.crumbs === null ? null : (Astro.props.crumbs || [{ name: t(locale, 'breadcrumb.home') }]);
const drafts = includeDrafts();
const links = FOOTER_LINKS
  .map((l) => ({ ...l, href: pathFor(l.id, locale, { drafts }) }))
  .filter((l) => l.href);
---
<footer class="site-footer">
  {crumbs && <div class="wrap" style="padding-bottom: 16px; border-bottom: 1px solid var(--panel-border-soft); margin-bottom: 16px;">
    <nav class="breadcrumb" aria-label={t(locale, 'breadcrumb.ariaLabel')} style="width: 100%;">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList" style="list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: center; font-size: 12px; color: var(--text-muted);">
        {crumbs.map((c, i) => (
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style="display: flex; align-items: center;">
            {i > 0 && <span aria-hidden="true" style="margin: 0 6px;">›</span>}
            {c.href
              ? <a itemprop="item" href={c.href} style="color: var(--text-muted); text-decoration: none;"><span itemprop="name">{c.name}</span></a>
              : <span itemprop="name" style="color: var(--text-main);">{c.name}</span>}
            <meta itemprop="position" content={String(i + 1)} />
          </li>
        ))}
      </ol>
    </nav>
  </div>}
  <div class="wrap">
    <span>{tagline ? `© GraphRace Studio — ${tagline}` : t(locale, 'footer.copyright')}</span>
    {links.length > 0 && (
      <nav>
        {links.map((l) => <>{'\n        '}<a href={l.href}>{t(locale, l.key)}</a></>)}
      </nav>
    )}
  </div>
</footer>
