---
// 利用規約｜GraphRace Studio（日本語）。旧 terms.html から移したもの（見た目・文章は同じ）。
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import { pathFor, includeDrafts } from '../i18n/utils.mjs';

const locale = 'ja';
// 特定商取引法に基づく表記へのリンク（公開前は下書きなので、本番ビルドでは出さない）
const tokushoho = pathFor('tokushoho', 'ja', { drafts: includeDrafts() });
---
<BaseLayout
  pageId="terms"
  title={"利用規約｜GraphRace Studio"}
  description={"データビジュアライゼーションツール「GraphRace Studio」の利用規約および商用利用に関するガイドラインについて説明します。"}
  ogTitle={"利用規約｜GraphRace Studio"}
  ogDescription={"データビジュアライゼーションツール「GraphRace Studio」の利用規約および商用利用に関するガイドラインについて説明します。"}
  twitterTitle={"利用規約｜GraphRace Studio"}
  twitterDescription={"データビジュアライゼーションツール「GraphRace Studio」の利用規約および商用利用に関するガイドラインについて説明します。"}
  ogType={"article"}
  ogImage={"https://graphrace-studio.com/Logo/GraphRace_Studio_Logo.jpg"}
>
  <Fragment slot="head">
  <style is:inline>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: var(--font-sans);
      color: var(--text-main);
      background: var(--app-bg);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    .wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }

    /* ヘッダ */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--panel-border);
      box-shadow: 0 2px 8px rgba(16, 18, 22, 0.02);
      transition: background 0.3s ease;
    }
    .site-header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 24px;
      max-width: 1040px;
      margin: 0 auto;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
      font-size: 16px;
      color: var(--text-strong);
      letter-spacing: 0.2px;
      text-decoration: none;
    }
    .brand img {
      height: 24px;
      width: auto;
      display: block;
    }
    .brand .dot { color: var(--accent); }
    .site-nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .nav-link {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 20px;
      transition: color .2s ease, background-color .2s ease;
    }
    .nav-link:hover {
      color: var(--accent);
      background-color: var(--accent-soft);
    }
    .nav-link.is-active {
      color: var(--accent-strong);
      background-color: var(--accent-soft);
    }

    @media (max-width: 768px) {
      .site-header-inner {
        flex-direction: column;
        gap: 12px;
        padding: 12px 16px;
      }
      .site-nav {
        width: 100%;
        overflow-x: auto;
        white-space: nowrap;
        justify-content: flex-start;
        padding-bottom: 4px;
        scrollbar-width: none;
      }
      .site-nav::-webkit-scrollbar {
        display: none;
      }
      .nav-link {
        padding: 6px 12px;
        font-size: 12px;
        flex-shrink: 0;
      }
    }

    /* 本文レイアウト */
    .page-title {
      font-size: clamp(28px, 5vw, 36px);
      color: var(--text-strong);
      font-weight: 800;
      margin: 48px 0 24px;
      text-align: center;
      letter-spacing: -0.5px;
    }
    .content-block {
      max-width: 700px;
      margin: 0 auto 56px;
    }
    .content-block section {
      padding: 12px 0;
    }
    .content-block h2 {
      font-size: 22px;
      color: var(--text-strong);
      border-bottom: 2px solid var(--panel-border);
      padding-bottom: 8px;
      margin-top: 36px;
    }
    .content-block p {
      font-size: 15px;
      color: var(--text-main);
      line-height: 1.8;
      margin: 16px 0;
    }
    .content-block ul {
      padding-left: 20px;
      margin: 16px 0;
    }
    .content-block li {
      font-size: 15px;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    /* フッタ */
    footer.site-footer {
      padding: 32px 0;
      color: var(--text-muted);
      font-size: 13px;
      border-top: 1px solid var(--panel-border);
      background: var(--panel-surface);
      margin-top: 80px;
    }
    .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; justify-content: space-between; }
    .site-footer nav a { color: var(--text-muted); text-decoration: none; margin-left: 18px; }
    .site-footer nav a:hover { color: var(--text-main); }

  </style>
  </Fragment>

  <SiteHeader pageId="terms" locale={locale} />

  <main class="wrap">
    <h1 class="page-title">利用規約</h1>

    <div class="content-block">
      <section>
        <p>本ツール（以下、当サービス）の利用規約および商用利用に関するガイドラインを定めます。ユーザーの皆様は、本規約に同意した上で当サービスをご利用ください。</p>
      </section>

      <section>
        <h2>利用許諾と商用利用の許可範囲</h2>
        <p>当サービスで作成したチャート画像や動画は、個人・法人を問わず、原則として無料でご利用いただけます。</p>
        <p>商用利用の条件：YouTube等の収益化動画、企業のWebサイト、プレゼンテーション資料、ニュースメディア、プロモーション資料等で作成物を利用される場合は、クレジット表記を必須とします。</p>
        <p>クレジット表記の例：作成物の近く、またはコンテンツの説明欄等の分かりやすい場所に、以下のいずれかの形式でクレジットを記載してください。</p>
        <ul>
          <li>Created with GraphRace Studio</li>
          <li>作成：GraphRace Studio (URL)</li>
        </ul>
      </section>

      <section>
        <h2>将来的な規約・サービスの変更について</h2>
        <p>当サービスは、今後のアップデートにより、機能の追加、会員登録制の導入、または無料機能と有料機能の区分などを実施する可能性があります。</p>
        <p>これに伴い、本規約や商用利用のライセンス形態（有料ライセンスの導入など）を変更することがあります。規約変更前に作成されたコンテンツへの適用範囲等については、変更時に合理的な猶予期間や基準を設けて案内します。</p>
      </section>

      <section>
        <h2>有料プランについて</h2>
        <p>1. プランと料金：有料機能（透かしなしの書き出し、高画質・透過書き出しなど）は、7日パス・月額プラン・年額プランのいずれかを購入すると使えます。内容と料金は<a href="/pricing" style="color: var(--accent); text-decoration: underline;">料金プランのページ</a>に表示します。お支払いは Stripe の決済画面で行います。</p>
        <p>2. ライセンスキー：購入が完了すると、ライセンスキーを購入完了ページに表示し、メールでもお送りします。ライセンスキーは、購入された方ご本人が作品づくりに使うためのものです。第三者への公開・共有・転売はできません。</p>
        <p>3. 自動更新と解約：7日パスは1回のお支払いで、自動更新はありません。月額・年額プランは、購入日を基準に毎月（年額は毎年）自動で更新されます。解約は Link（link.com）からいつでもでき、次回の更新日より前に解約すれば、以降の請求はありません。解約後も、お支払い済みの期間の終わりまでは使えます。</p>
        <p>4. 返金：デジタルコンテンツの性質上、お客様のご都合による返品・返金・キャンセルはお受けしていません。更新後の期間分の返金や日割りでの返金も、原則として行いません。ただし、二重にお支払いいただいた場合や、不具合によりご利用いただけない場合は、メールでご連絡ください。内容を確認のうえ、返金します。</p>
        <p>5. 利用の停止：返金・支払いの取り消し・不正な利用があった場合、そのライセンスキーは使えなくなります。</p>
        <p>6. 価格・内容の変更：料金や有料機能の内容を変更することがあります。変更はサイト上でお知らせし、すでにお支払い済みの期間には影響しません。</p>
        <p>7. 販売者などの表示：特定商取引法に基づく表記は{tokushoho ? <a href={tokushoho} style="color: var(--accent); text-decoration: underline;">こちら</a> : 'サイト上'}をご確認ください。お問い合わせは support@graphrace-studio.com までお願いします。</p>
      </section>

      <section>
        <h2>禁止事項</h2>
        <p>ユーザーは、当サービスの利用にあたり、以下の行為を行ってはなりません。</p>
        <ul>
          <li>公序良俗または法令に反するコンテンツにおいて当サービスで作成した画像や動画を使用すること。</li>
          <li>当サービスのソースコードやデザインを流用し、競合となるサービスを再配布・公開すること。</li>
          <li>サーバーやネットワークに過度な負荷をかける等、運営を妨害する行為。</li>
        </ul>
      </section>

      <section>
        <h2>免責事項</h2>
        <p>1. サービスの提供および品質について：当サービスは、その正確性、完全性、有用性、および特定の目的への適合性について、明示的にも黙示的にも一切保証しません。</p>
        <p>2. 損害についての免責：当サービスの利用、または利用できなかったことによって生じた一切の損害（データの消失、業務の中断、精神的苦痛、その他の金銭的損失を含む）について、開発者は一切の責任を負いません。</p>
        <p>3. 外部サービスの連携について：当サービスから外部サイトへのリンクや、外部API等の連携機能を利用した結果生じたトラブルについて、開発者は一切の責任を負いません。</p>
      </section>
    </div>
  </main>

  <SiteFooter locale={locale} crumbs={[{ name: "ホーム", href: "/" }, { name: "利用規約" }]} tagline="データビジュアライゼーションツール" />
</BaseLayout>
