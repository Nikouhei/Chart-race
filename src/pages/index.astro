---
// トップページ（日本語）
// 本文は旧 index.html から移したもの。ヘッダー・フッター・<head> の共通部分はレイアウトとコンポーネントにある。
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import homeCss from '../styles/home.css?raw';

const locale = 'ja';
---
<BaseLayout
  pageId="home"
  title="GraphRace Studio｜無料・動くグラフ＆ランキング動画作成ツール"
  description="動くバーチャートレース、線グラフレース、円グラフレース、トーナメント表アニメーション、格付けダービー（競馬風・3Dリアル競馬風）、カード型ランキング動画、あみだくじを無料で作成。インストール不要・すべてブラウザ上で安全に動作します。"
  twitterDescription="動くバーチャートレース、線グラフ、円グラフ、トーナメント表、競馬風レース、ランキング動画、あみだくじを無料でブラウザ作成。"
>
  <Fragment slot="head">
  <style is:inline set:html={homeCss}></style>

  <!-- 構造化データ -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://graphrace-studio.com/#website",
        "url": "https://graphrace-studio.com/",
        "name": "GraphRace Studio",
        "alternateName": ["グラフレーススタジオ"],
        "description": "動くバーチャートレース、線グラフレース、円グラフレース、トーナメント表アニメーション、格付けダービー（競馬風・3Dリアル競馬風）、カード型ランキング動画、あみだくじを無料で作成。インストール不要・すべてブラウザ上で安全に動作します。",
        "publisher": {
          "@id": "https://graphrace-studio.com/#organization"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://graphrace-studio.com/#organization",
        "name": "GraphRace Studio",
        "url": "https://graphrace-studio.com/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://graphrace-studio.com/Logo/GraphRace_Studio_Logo.png"
        }
      }
    ]
  }
  </script>
  </Fragment>

  <SiteHeader pageId="home" locale={locale} />


  <main>
    <!-- ヒーローセクション -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-flex">
          <div class="hero-text">
            <div class="hero-badges">
              <span class="badge">完全無料（要クレジット表記）</span>
              <span class="badge">インストール不要</span>
              <span class="badge">商用利用OK</span>
              <span class="badge">外部送信なし</span>
            </div>
            <h1>データ・ランキング・対戦・抽選を、<br>ダイナミックな演出に</h1>
            <p class="lead">CSVや手動入力から、動きのあるグラフ動画、勝ち上がりトーナメント表、格付けダービー、カード型ランキング動画、公平なあみだくじ抽選演出をブラウザ内で無料作成できます。</p>
          </div>
          
          <div class="hero-visual">
            <div class="demo-tabs">
              <button class="demo-tab-btn is-active" data-tab="tab-barchart">📊 バーチャート</button>
              <button class="demo-tab-btn" data-tab="tab-bracket">🏆 トーナメント</button>
              <button class="demo-tab-btn" data-tab="tab-derby">🏇 格付けダービー</button>
              <button class="demo-tab-btn" data-tab="tab-ranking">🏅 ランキング</button>
            </div>

            <!-- Tab 1: バーチャートレース -->
            <div id="tab-barchart" class="demo-tab-content is-active">
              <div class="demo-header">
                <span class="demo-title">📊 世界スマホシェア推移 (デモ)</span>
                <span style="font-size: 11px; color: var(--text-muted); font-weight:700;">PREVIEW</span>
              </div>
              <div class="demo-barchart-stage">
                <div id="demo-container" class="demo-bar-list"></div>
                <div id="demo-year" class="demo-year-badge">2020年</div>
              </div>
            </div>

            <!-- Tab 2: トーナメント表 -->
            <div id="tab-bracket" class="demo-tab-content">
              <div class="demo-header">
                <span class="demo-title">🏆 第3回 グラフレース杯</span>
                <span id="bracket-status" style="font-size: 11px; color: var(--accent); font-weight:700;">2回戦 進行中</span>
              </div>
              <div class="bracket-stage">
                <div class="bracket-grid">
                  <!-- 2回戦（8チーム） -->
                  <div class="bracket-col">
                    <div class="bracket-round-label">2回戦</div>
                    <div class="bracket-col-body" id="bround-1"></div>
                  </div>
                  <!-- 準決勝（4チーム） -->
                  <div class="bracket-col">
                    <div class="bracket-round-label">準決勝</div>
                    <div class="bracket-col-body" id="bround-2"></div>
                  </div>
                  <!-- 決勝（2チーム） -->
                  <div class="bracket-col">
                    <div class="bracket-round-label">決勝</div>
                    <div class="bracket-col-body" id="bround-3"></div>
                  </div>
                </div>
                <div class="bracket-champion" id="bracket-champion">👑 優勝　雷電</div>
              </div>
            </div>

            <!-- Tab 3: 格付けダービー -->
            <div id="tab-derby" class="demo-tab-content">
              <div class="demo-header">
                <span class="demo-title">🏇 格付けダービー G1</span>
                <span id="derby-status" style="font-size: 11px; color: #c9a227; font-weight:800;">発走前</span>
              </div>
              <div class="derby-stage">
                <div class="derby-stands"></div>
                <div class="derby-rail"></div>
                <div class="derby-turf-stripes"></div>
                <div class="derby-goal" id="derby-goal"></div>
                <div id="derby-runners"></div>
                <div class="derby-topbar">
                  <span>第3回 グラフレース記念</span>
                  <span class="derby-topbar-sub" id="derby-topbar-sub">芝1600m・8頭立て</span>
                </div>
                <div class="derby-caption" id="derby-caption">まもなくスタート！</div>
                <div class="derby-board" id="derby-board"></div>
              </div>
            </div>

            <!-- Tab 4: ランキング動画 -->
            <div id="tab-ranking" class="demo-tab-content">
              <div class="demo-header">
                <span class="demo-title">🏅 人気ラーメンランキング TOP 5</span>
                <span id="ranking-counter" style="font-size: 11px; color: var(--accent); font-weight:700;">▶ PLAYING</span>
              </div>
              <div class="ranking-stage">
                <div id="ranking-track" class="ranking-track"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ツール選択セクション -->
    <section id="tools" style="border-top: 1px solid var(--panel-border);">
      <div class="wrap">
        <h2 class="section-title">全7種類の演出ツール</h2>
        <p class="section-sub">用途やコンテンツに合わせて、お好みのツールをブラウザで選択・ご利用いただけます。</p>
        
        <div class="tools-grid">
          <!-- 1. バーチャートレース作成ツール -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">📊</div>
                <span class="tool-category-badge">時系列グラフ</span>
              </div>
              <h4>バーチャートレース作成ツール</h4>
              <p>時系列データのランキング変動を、軽快に走るアニメーション棒グラフとして視覚化します。SNS発信やYouTubeの動画コンテンツに最適です。</p>
              <div class="tool-tags">
                <span class="tool-tag">CSV / Excel対応</span>
                <span class="tool-tag">縦横比率自由</span>
                <span class="tool-tag">国旗・アイコン対応</span>
              </div>
            </div>
            <a class="btn-tool" href="bar-chart-race/">ツールを使う</a>
          </div>

          <!-- 2. 線グラフレース作成ツール -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">📈</div>
                <span class="tool-category-badge">折れ線グラフ</span>
              </div>
              <h4>線グラフレース作成ツール</h4>
              <p>複数項目の時系列データをすっきりと比較する動的折れ線グラフを作成します。プレゼン資料やブログ、ニュース解説図解に適しています。</p>
              <div class="tool-tags">
                <span class="tool-tag">CSV / Excel対応</span>
                <span class="tool-tag">デザインカスタマイズ</span>
                <span class="tool-tag">データ自動保存</span>
              </div>
            </div>
            <a class="btn-tool" href="regular-chart/">ツールを使う</a>
          </div>

          <!-- 3. 円グラフレース作成ツール -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">🥧</div>
                <span class="tool-category-badge">円グラフ</span>
              </div>
              <h4>円グラフレース作成ツール</h4>
              <p>年ごとに割合が変わっていく円グラフ・ドーナツグラフの動画を作成します。市場シェアや電源構成、売上構成比の移り変わりを伝えるのに最適です。</p>
              <div class="tool-tags">
                <span class="tool-tag">CSV / Excel対応</span>
                <span class="tool-tag">円・ドーナツ切替</span>
                <span class="tool-tag">割合を自動計算</span>
              </div>
            </div>
            <a class="btn-tool" href="pie-chart-race/">ツールを使う</a>
          </div>

          <!-- 3. ランキング動画メーカー -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">🏅</div>
                <span class="tool-category-badge">順位発表動画</span>
              </div>
              <h4>ランキング動画メーカー</h4>
              <p>順位・画像・名称・説明を入力するだけで、カードが右から流れてランクインする動画を作成します。YouTube ShortsやTikTokに最適です。</p>
              <div class="tool-tags">
                <span class="tool-tag">画像アップロード</span>
                <span class="tool-tag">縦型Shorts推奨</span>
                <span class="tool-tag">カードアニメーション</span>
              </div>
            </div>
            <a class="btn-tool" href="ranking-video-maker/">ツールを使う</a>
          </div>

          <!-- 4. 格付けダービー -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">🏇</div>
                <span class="tool-category-badge">競馬風レース</span>
              </div>
              <h4>格付けダービー（競馬風ランキング動画）</h4>
              <p>順位を決めて走らせるだけで、本格的な競馬中継風のレース動画を作成します。道中の展開は毎回ランダムで盛り上がり抜群。軽快な2Dと、3DCGの馬が走る「リアル競馬風」を切り替えて使えます。</p>
              <div class="tool-tags">
                <span class="tool-tag">確定順位指定</span>
                <span class="tool-tag">ランダムレース展開</span>
                <span class="tool-tag">競馬実況演出</span>
                <span class="tool-tag">3Dリアル対応</span>
              </div>
            </div>
            <a class="btn-tool" href="horse-race-ranking-maker/">ツールを使う</a>
          </div>

          <!-- 5. トーナメント表アニメーター -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">🏆</div>
                <span class="tool-category-badge">トーナメント</span>
              </div>
              <h4>トーナメント表アニメーター</h4>
              <p>参加人数や組み合わせを選ぶだけで、勝ち上がりがアニメーションで進む華やかなトーナメント表を作成します。大会の演出や配信画面に最適です。</p>
              <div class="tool-tags">
                <span class="tool-tag">シード対応</span>
                <span class="tool-tag">自動勝ち上がりアニメ</span>
                <span class="tool-tag">ゲーム・スポーツ大会</span>
              </div>
            </div>
            <a class="btn-tool" href="tournament-bracket-animator/">ツールを使う</a>
          </div>

          <!-- 6. あみだくじメーカー -->
          <div class="tool-card">
            <div class="card-top">
              <div class="tool-card-header">
                <div class="icon">🎲</div>
                <span class="tool-category-badge">くじ引き・抽選</span>
              </div>
              <h4>あみだくじメーカー</h4>
              <p>参加者と結果を入力するだけで、公平なあみだくじを自動作成。光る軌跡のアニメーションや効果音、紙吹雪演出で盛り上がります。便利なチーム分けモードやURL共有にも対応。</p>
              <div class="tool-tags">
                <span class="tool-tag">完全ランダム生成</span>
                <span class="tool-tag">チーム分け対応</span>
                <span class="tool-tag">アニメ演出・効果音</span>
                <span class="tool-tag">URL共有・画像保存</span>
              </div>
            </div>
            <a class="btn-tool" href="amidakuji-maker/">ツールを使う</a>
          </div>
        </div>

      </div>
    </section>

    <!-- ユースケース -->
    <section style="border-top: 1px solid var(--panel-border);">
      <div class="wrap">
        <h2 class="section-title">あらゆるシーンで視線を引きつける</h2>
        <p class="section-sub">GraphRace Studioは、数字やランキング、抽選や対戦を魅力的な動的演出へ変えるフリーツール群です。</p>
        <div class="use-cases-grid">
          <div class="use-case-card">
            <div class="icon-wrapper">📱</div>
            <h3>SNSショート動画でエンゲージメント向上</h3>
            <p>YouTube Shorts、TikTok、Instagramリール向けに、目を引くランキング比較やダービー演出動画を発信できます。</p>
          </div>
          <div class="use-case-card">
            <div class="icon-wrapper">🎮</div>
            <h3>大会・イベント・ゲーム配信での対戦演出</h3>
            <p>トーナメント表アニメーションやあみだくじで、対戦カードの組み合わせ・勝ち上がり・グループ分けをダイナミックに実況・演出できます。</p>
          </div>
          <div class="use-case-card">
            <div class="icon-wrapper">💼</div>
            <h3>ビジネスプレゼン・ビジネスレポート</h3>
            <p>売上推移や市場シェアの動きをバーチャートレースや折れ線グラフレースで見せ、説得力を最大化します。</p>
          </div>
          <div class="use-case-card">
            <div class="icon-wrapper">🎓</div>
            <h3>統計データ・解説コンテンツ</h3>
            <p>人口推移や歴史データなど複雑な数値をアニメーション化し、教育現場やブログでの解説に活用できます。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 安全と安心の設計 -->
    <section style="background: var(--panel-surface); border-top: 1px solid var(--panel-border); border-bottom: 1px solid var(--panel-border);">
      <div class="wrap">
        <h2 class="section-title">安全と安心の設計</h2>
        <p class="section-sub">本サイトは、プライバシーの保護と操作の軽快さにこだわって作られています。</p>
        <div class="features">
          <div class="feature-card">
            <div class="ico">🔒</div>
            <h3>外部送信なし</h3>
            <p>データ処理は100%ユーザーのブラウザ（端末内）で完結。サーバーにデータがアップロードされることはありません。</p>
          </div>
          <div class="feature-card">
            <div class="ico">💾</div>
            <h3>ブラウザ内保存</h3>
            <p>編集データはブラウザのローカル保存領域にのみ安全に保持されます。第三者がアクセスすることはできません。</p>
          </div>
          <div class="feature-card">
            <div class="ico">🛡️</div>
            <h3>安全な標準ライブラリ</h3>
            <p>D3.jsやCanvas APIなど、世界的によく使われている信頼性の高いオープンソース技術のみを使用しています。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- よくあるご質問 (FAQ) -->
    <section style="border-bottom: 1px solid var(--panel-border);">
      <div class="wrap">
        <h2 class="section-title">よくあるご質問</h2>
        <p class="section-sub">ツールの利用方法や仕様に関するよくある疑問にお答えします。</p>
        <div class="faq-list">
          <details class="faq-item">
            <summary><h3>完全に無料で使えますか？商用利用は可能ですか？</h3></summary>
            <div class="faq-content">
              はい、全ツールを完全無料でご利用いただけます。YouTube等の動画投稿、SNSでの発信、ビジネスプレゼンテーションなどの商用利用も可能です。作成したコンテンツを一般に公開・配信する際は、当サイトへのクレジット表記（例: 「Created by GraphRace Studio」の記載やリンク設置）を必須とさせていただいております。
            </div>
          </details>
          <details class="faq-item">
            <summary><h3>どのような形式（MP4/WebM等）で動画を保存できますか？</h3></summary>
            <div class="faq-content">
              ツールによって異なります。バーチャートレース・線グラフレース・円グラフレースは、画面下の「動画を保存」ボタンからMP4またはWebMの動画ファイルとして書き出せます。プレビューと同じ動きを1コマずつ動画にするので、画面録画のようなカクつきや余計な映り込みはありません。格付けダービーも「動画を保存」から、レースをMP4またはWebMの動画ファイルとして書き出せます。あみだくじメーカーは結果をPNG画像で保存できます。ランキング動画メーカーとトーナメント表アニメーターは、再生中の画面をパソコンやスマホの画面録画機能で保存してください。
            </div>
          </details>
          <details class="faq-item">
            <summary><h3>アップロードしたデータや画像が外部に漏れる心配はありませんか？</h3></summary>
            <div class="faq-content">
              ご安心ください。すべてのデータ処理および画像読み込み・描画はお使いのブラウザ内（端末上）で完結します。入力された数値やファイルが外部のサーバーに転送・保存されることは一切ありません。
            </div>
          </details>
          <details class="faq-item">
            <summary><h3>あみだくじやトーナメント表、格付けダービーの入力は難しいですか？</h3></summary>
            <div class="faq-content">
              非常にシンプルです。あみだくじメーカーやトーナメント表アニメーターは参加者名を入力するだけで公平な線を自動生成・アニメーション演出できます。格付けダービーも順位（ゴール順）と馬名・カラーを選択するだけで簡単に本格的な競馬風動画を作成できます。
            </div>
          </details>
          <details class="faq-item">
            <summary><h3>スマートフォンやタブレットでも操作できますか？</h3></summary>
            <div class="faq-content">
              はい、GraphRace Studioのすべてのツールはスマートフォンおよびタブレットの画面レイアウトに最適化されています。スマホのみでデータの入力・編集から動画の保存まで完結可能です。
            </div>
          </details>
          <details class="faq-item">
            <summary><h3>作成した動画をYouTube ShortsやTikTokに投稿しても良いですか？</h3></summary>
            <div class="faq-content">
              もちろんです。縦型動画（9:16）アスペクト比調整機能に対応しているツールも多く、YouTube ShortsやTikTok、Instagramリール等のショート動画フォーマットに最適な演出を作成いただけます。
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- 更新履歴 -->
    <section class="update-history">
      <div class="wrap">
        <h2 class="section-title">更新履歴</h2>
        <div class="update-list-container">
          <ul class="update-list">
            <li class="update-item">
              <span class="badge-new">New</span>
              <span class="update-date">2026.10.26</span>
              <span class="update-content">円グラフレース作成ツールを公開しました。年ごとに割合が変わる円グラフ・ドーナツグラフの動画を、MP4／WebMで保存できます。</span>
            </li>
            <li class="update-item">
              <span class="badge-new">New</span>
              <span class="update-date">2026.10.24</span>
              <span class="update-content">バーチャートレース・線グラフレース：設定に「凡例」の項目を追加し、凡例の設定を1か所にまとめました。線グラフレースでも、カテゴリの凡例の位置・並び方向・背景などを細かく設定できます。</span>
            </li>
            <li class="update-item">
              <span class="badge-new">New</span>
              <span class="update-date">2026.10.17</span>
