  <SiteFooter locale={locale} />

  <script is:inline>
    // タブ切り替えと各デモのコントロール
    document.addEventListener('DOMContentLoaded', () => {
      const tabBtns = document.querySelectorAll('.demo-tab-btn');
      const tabContents = document.querySelectorAll('.demo-tab-content');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-tab');
          tabBtns.forEach(b => b.classList.remove('is-active'));
          tabContents.forEach(c => c.classList.remove('is-active'));
          btn.classList.add('is-active');
          const targetContent = document.getElementById(targetId);
          if (targetContent) targetContent.classList.add('is-active');

          if (targetId === 'tab-bracket') triggerBracketDemo();
          if (targetId === 'tab-derby') triggerDerbyDemo();
          if (targetId === 'tab-ranking') triggerRankingDemo();
        });
      });

      // 1. バーチャートレースデモ
      (function() {
        const items = [
          { id: 'apple', label: 'Apple', icon: '🍎', color: 'linear-gradient(90deg, #ff7675, #d63031)', value: 85, target: 85 },
          { id: 'samsung', label: 'Samsung', icon: '📱', color: 'linear-gradient(90deg, #74b9ff, #0984e3)', value: 68, target: 68 },
          { id: 'xiaomi', label: 'Xiaomi', icon: '🔴', color: 'linear-gradient(90deg, #fab1a0, #e17055)', value: 48, target: 48 },
          { id: 'oppo', label: 'OPPO', icon: '🟢', color: 'linear-gradient(90deg, #55efc4, #00b894)', value: 32, target: 32 }
        ];

        const demoContainer = document.getElementById('demo-container');
        const demoYear = document.getElementById('demo-year');
        if (!demoContainer || !demoYear) return;

        items.forEach((item, idx) => {
          const el = document.createElement('div');
          el.className = 'demo-bar-item';
          el.id = `demo-item-${item.id}`;
          el.setAttribute('data-rank', idx + 1);
          el.style.transform = `translateY(${idx * 44}px)`;
          el.innerHTML = `
            <span class="demo-rank-num">${idx + 1}</span>
            <span class="demo-bar-icon">${item.icon}</span>
            <span class="demo-label">${item.label}</span>
            <div class="demo-track">
              <div class="demo-bar-fill" style="width: 0%; background: ${item.color};"></div>
            </div>
            <span class="demo-value">0%</span>
          `;
          demoContainer.appendChild(el);
        });

        let year = 2020;
        
        function updateDemo() {
          year += 1;
          if (year > 2025) {
            year = 2020;
            items[0].target = 85;
            items[1].target = 68;
            items[2].target = 48;
            items[3].target = 32;
          } else {
            items.forEach(item => {
              const diff = Math.floor(Math.random() * 30) - 12;
              item.target = Math.max(15, Math.min(95, item.target + diff));
            });
          }

          demoYear.textContent = year + '年';
          items.forEach(item => { item.value = item.target; });

          const sorted = [...items].sort((a, b) => b.value - a.value);

          items.forEach(item => {
            const el = document.getElementById(`demo-item-${item.id}`);
            if (el) {
              const index = sorted.findIndex(s => s.id === item.id);
              el.setAttribute('data-rank', index + 1);
              el.style.transform = `translateY(${index * 44}px)`;
              
              const rankNum = el.querySelector('.demo-rank-num');
              if (rankNum) rankNum.textContent = index + 1;

              const fill = el.querySelector('.demo-bar-fill');
              if (fill) fill.style.width = `${item.value}%`;
              
              const valEl = el.querySelector('.demo-value');
              if (valEl) valEl.textContent = `${Math.round(item.value)}%`;
            }
          });
        }

        setTimeout(updateDemo, 100);
        setInterval(updateDemo, 1800);
      })();

      // 2. トーナメント表デモ
      let bracketTimeout = null;
      // 2回戦（8チーム）→ 準決勝 → 決勝。各試合は [上, 下] で winner は 0 or 1
      const BRACKET_ROUNDS = [
        [
          { teams: ['⚡ 雷電', '🔥 紅蓮'], scores: [2, 1], winner: 0 },
          { teams: ['❄️ 蒼氷', '🌪 疾風'], scores: [3, 0], winner: 0 },
          { teams: ['🌟 黄金', '🖤 漆黒'], scores: [1, 2], winner: 1 },
          { teams: ['🍀 翠嵐', '🌌 銀河'], scores: [0, 1], winner: 1 }
        ],
        [
          { teams: ['⚡ 雷電', '❄️ 蒼氷'], scores: [2, 1], winner: 0 },
          { teams: ['🖤 漆黒', '🌌 銀河'], scores: [0, 1], winner: 1 }
        ],
        [
          { teams: ['⚡ 雷電', '🌌 銀河'], scores: [3, 2], winner: 0 }
        ]
      ];
      const BRACKET_ROUND_NAMES = ['2回戦', '準決勝', '決勝'];

      function buildBracketRound(containerId, matchCount) {
        const el = document.getElementById(containerId);
        if (!el) return [];
        el.innerHTML = '';
        const slots = [];
        for (let m = 0; m < matchCount; m++) {
          const match = document.createElement('div');
          match.className = 'bracket-match';
          for (let i = 0; i < 2; i++) {
            const slot = document.createElement('div');
            slot.className = 'bracket-slot is-empty';
            slot.innerHTML = '<span class="bracket-name">未定</span><span class="bracket-score"></span>';
            match.appendChild(slot);
            slots.push(slot);
          }
          el.appendChild(match);
        }
        return slots;
      }

      function fillBracketSlot(slot, name, score) {
        if (!slot) return;
        slot.classList.remove('is-empty', 'is-winner', 'is-champion');
        slot.querySelector('.bracket-name').textContent = name;
        slot.querySelector('.bracket-score').textContent = score === null ? '-' : score;
      }

      function triggerBracketDemo() {
        if (bracketTimeout) clearTimeout(bracketTimeout);

        const statusEl = document.getElementById('bracket-status');
        const championEl = document.getElementById('bracket-champion');
        const rounds = [
          buildBracketRound('bround-1', 4),
          buildBracketRound('bround-2', 2),
          buildBracketRound('bround-3', 1)
        ];

        if (championEl) championEl.classList.remove('is-visible');
        if (statusEl) statusEl.textContent = '2回戦 進行中';

        // 2回戦は最初から出そろっている（スコアは未確定）
        BRACKET_ROUNDS[0].forEach((match, m) => {
          fillBracketSlot(rounds[0][m * 2], match.teams[0], null);
          fillBracketSlot(rounds[0][m * 2 + 1], match.teams[1], null);
        });

        // ラウンドを1つずつ決着させる
        function playRound(r) {
          const matches = BRACKET_ROUNDS[r];
          matches.forEach((match, m) => {
            const a = rounds[r][m * 2];
            const b = rounds[r][m * 2 + 1];
            fillBracketSlot(a, match.teams[0], match.scores[0]);
            fillBracketSlot(b, match.teams[1], match.scores[1]);
            (match.winner === 0 ? a : b).classList.add('is-winner');
          });

          const next = BRACKET_ROUNDS[r + 1];
          if (next) {
            if (statusEl) statusEl.textContent = BRACKET_ROUND_NAMES[r] + ' 終了 → ' + BRACKET_ROUND_NAMES[r + 1] + 'へ';
            next.forEach((match, m) => {
              fillBracketSlot(rounds[r + 1][m * 2], match.teams[0], null);
              fillBracketSlot(rounds[r + 1][m * 2 + 1], match.teams[1], null);
            });
            bracketTimeout = setTimeout(() => {
              if (statusEl) statusEl.textContent = BRACKET_ROUND_NAMES[r + 1] + ' 進行中';
              bracketTimeout = setTimeout(() => playRound(r + 1), 1000);
            }, 900);
          } else {
            const finalMatch = matches[0];
            const championSlot = rounds[r][finalMatch.winner];
            championSlot.classList.add('is-champion');
            const championName = finalMatch.teams[finalMatch.winner];
            if (statusEl) statusEl.textContent = '👑 優勝決定！';
            if (championEl) {
              championEl.textContent = '👑 優勝　' + championName;
              championEl.classList.add('is-visible');
            }
            bracketTimeout = setTimeout(triggerBracketDemo, 3500);
          }
        }

        bracketTimeout = setTimeout(() => playRound(0), 1200);
      }

      // 3. 格付けダービーデモ（馬が左→右に走る）
      let derbyRAF = null;
      let derbyTimeout = null;
      // 枠番・馬名・脚質は実ツールの入力項目に合わせた並び
      const DERBY_HORSES = [
        { gate: 1, name: 'サンダー', color: '#ffffff', numColor: '#000', style: 'nige' },
        { gate: 2, name: 'ファントム', color: '#1c1c1c', numColor: '#fff', style: 'senko' },
        { gate: 3, name: 'ブレイズ', color: '#e74c3c', numColor: '#fff', style: 'sashi' },
        { gate: 4, name: 'コメット', color: '#2980b9', numColor: '#fff', style: 'oikomi' },
        { gate: 5, name: 'ホライズン', color: '#f1c40f', numColor: '#000', style: 'senko' }
      ];
      // 実況テロップ（実ツールの commentary() と同じ文面パターン）
      function derbyCommentary(p, lead, second) {
        if (p < 0.05) return '各馬一斉にスタート！';
        if (p < 0.3) return `先頭は${lead}！${second}が続く！`;
        if (p < 0.55) return `${lead}がレースを引っ張る展開！`;
        if (p < 0.8) return `第4コーナーを回った！先頭${lead}！`;
        if (p < 0.97) return `最後の直線！${lead}か！？${second}が迫る！`;
        return 'ゴール前！接戦だーッ！！';
      }

      function triggerDerbyDemo() {
        if (derbyRAF) cancelAnimationFrame(derbyRAF);
        if (derbyTimeout) clearTimeout(derbyTimeout);

        const stage = document.querySelector('.derby-stage');
        const runnersEl = document.getElementById('derby-runners');
        const statusEl = document.getElementById('derby-status');
        const captionEl = document.getElementById('derby-caption');
        const boardEl = document.getElementById('derby-board');
        const goalEl = document.getElementById('derby-goal');
        if (!stage || !runnersEl) return;

        const n = DERBY_HORSES.length;
        const startPct = 4;    // 発走地点（stage幅に対する%）
        const goalPct = 86;    // ゴール板の位置
        if (goalEl) goalEl.style.left = goalPct + '%';

        // 馬を配置（奥のレーンほど小さく＝実ツールの遠近と同じ）
        runnersEl.innerHTML = '';
        const horses = DERBY_HORSES.map((h, i) => {
          const el = document.createElement('div');
          el.className = 'derby-runner';
          const depth = (i + 0.5) / n;
          el.style.top = (46 + depth * 32) + '%';
          el.style.left = startPct + '%';
          el.style.transform = 'scale(' + (0.88 + depth * 0.16).toFixed(3) + ')';
          el.innerHTML =
            '<span class="derby-runner-name"></span>' +
            '<span class="derby-runner-body">' +
              '<span class="derby-runner-num"></span>' +
              '<span class="derby-runner-emoji">🏇</span>' +
            '</span>';
          el.querySelector('.derby-runner-name').textContent = h.name;
          const num = el.querySelector('.derby-runner-num');
          num.textContent = h.gate;
          num.style.background = h.color;
          num.style.color = h.numColor;
          runnersEl.appendChild(el);
          return { def: h, el: el, pos: 0, finished: false, time: 0 };
        });

        if (boardEl) { boardEl.classList.remove('is-visible'); boardEl.innerHTML = ''; }
        if (statusEl) { statusEl.textContent = '発走前'; statusEl.style.color = '#c9a227'; }
        if (captionEl) { captionEl.style.display = ''; captionEl.textContent = 'まもなくスタート！'; }

        derbyTimeout = setTimeout(() => {
          if (statusEl) { statusEl.textContent = '発走！'; statusEl.style.color = '#8ef0a8'; }

          const results = [];
          let lastTime = performance.now();
          let elapsed = 0;

          function step(now) {
            const dt = Math.min((now - lastTime) / 1000, 0.1);
            lastTime = now;
            elapsed += dt;
            let allDone = true;

            horses.forEach(h => {
              if (h.finished) return;
              allDone = false;
              // 脚質で速度の出方を変える（逃げは前半、追込は後半に伸びる）
              const p = h.pos;
              let v = 20 + Math.random() * 8;
              if (h.def.style === 'nige') v += 14 * (1 - p);
              else if (h.def.style === 'senko') v += 9;
              else if (h.def.style === 'sashi') v += 16 * p;
              else v += 22 * p * p;
              h.pos = Math.min(1, h.pos + (v / 100) * dt);
              h.el.style.left = (startPct + h.pos * (goalPct - startPct)) + '%';

              if (h.pos >= 1) {
                h.finished = true;
                h.time = elapsed;
                results.push(h);
              }
            });

            // 先頭・2番手から実況テロップを更新
            const sorted = [...horses].sort((a, b) => b.pos - a.pos);
            if (captionEl) {
              captionEl.textContent = derbyCommentary(sorted[0].pos, sorted[0].def.name, sorted[1].def.name);
            }

            if (allDone) {
              if (statusEl) { statusEl.textContent = '👑 ' + results[0].def.name; statusEl.style.color = '#f1c40f'; }
              if (captionEl) captionEl.style.display = 'none';
              // 結果掲示板（実ツールの「― 結果発表 ―」と同じ体裁）
              if (boardEl) {
                const base = 94.2;
                boardEl.innerHTML = '<div class="derby-board-title">― 結果発表 ―</div>' +
                  results.map((h, i) => {
                    const t = base + i * 0.3 + h.def.gate * 0.05;
                    const time = '1:' + t.toFixed(1);
                    return '<div class="derby-board-row">' +
                      '<span class="derby-board-rank">' + (i + 1) + '着</span>' +
                      '<span>' + h.def.name + '</span>' +
                      '<span class="derby-board-time">' + time + '</span>' +
                      '</div>';
                  }).join('');
                boardEl.classList.add('is-visible');
              }
              derbyTimeout = setTimeout(triggerDerbyDemo, 3500);
              return;
            }

            derbyRAF = requestAnimationFrame(step);
          }
          derbyRAF = requestAnimationFrame(step);
        }, 800);
      }

      // 4. ランキング動画デモ（カードが右→左にベルトコンベア式で流れる）
      let rankingRAF = null;
      function triggerRankingDemo() {
        if (rankingRAF) cancelAnimationFrame(rankingRAF);

        const trackEl = document.getElementById('ranking-track');
        if (!trackEl) return;

        const items = [
          { rank: '第5位', emoji: '🍛', name: '特製カレーうどん', desc: '和風ダシと本格スパイスの融合' },
          { rank: '第4位', emoji: '🥟', name: '手包み餃子セット', desc: '皮から手作り・肉汁たっぷり' },
          { rank: '第3位', emoji: '🌶️', name: '旨辛味噌ラーメン', desc: 'クセになる特製スパイスとコク旨スープ' },
          { rank: '第2位', emoji: '🥢', name: '特製魚介つけ麺', desc: '濃厚豚骨スープと柚子の薫りが絶品' },
          { rank: '第1位', emoji: '🍜', name: '濃厚醤油ラーメン', desc: '秘伝の極深ダレと自家製太麺・圧倒的1位！' }
        ];

        const stageEl = trackEl.parentElement;
        const stageWidth = stageEl ? stageEl.clientWidth : 400;
        // 実ツール準拠：幅に応じた表示枠数からカード幅を算出（16:9相当＝4枠）
        const slots = 4;
        const gap = Math.max(4, Math.round(stageWidth * 0.008));
        const slotW = Math.round((stageWidth - gap * (slots + 1)) / slots);
        trackEl.style.setProperty('--slot-w', slotW + 'px');
        trackEl.style.setProperty('--slot-gap', gap + 'px');
        trackEl.style.paddingLeft = gap + 'px';
        trackEl.style.paddingRight = gap + 'px';

        // カードをJS生成
        trackEl.innerHTML = '';
        trackEl.style.transform = 'translateX(0px)';

        items.forEach(item => {
          const card = document.createElement('div');
          card.className = 'rv-card';
          card.innerHTML = `
            <div class="rv-rank">${item.rank}</div>
            <div class="rv-img">${item.emoji}</div>
            <div class="rv-name">${item.name}</div>
            <div class="rv-desc">${item.desc}</div>
          `;
          trackEl.appendChild(card);
        });

        // 第5位のカードが右端から流れ込んで開始 → 最後のカードが右端に揃う位置で停止
        let offset = -stageWidth;
        const maxOffset = Math.max(0, trackEl.scrollWidth - stageWidth);
        const speed = stageWidth * 0.10; // px per second
        let lastTime = performance.now();
        const fadeZone = stageWidth * 0.22;
        const cards = Array.from(trackEl.querySelectorAll('.rv-card'));

        function applyFrame() {
          trackEl.style.transform = `translateX(${-offset}px)`;
          cards.forEach(card => {
            const left = card.offsetLeft - offset;
            if (left >= stageWidth) {
              card.style.opacity = '0';
              card.style.transform = 'translateY(10px)';
              return;
            }
            const p = Math.min(1, Math.max(0, (stageWidth - left) / fadeZone));
            card.style.opacity = String(p);
            card.style.transform = p < 1 ? `translateY(${Math.round((1 - p) * 10)}px)` : '';
          });
        }

        applyFrame();

        function step(now) {
          const dt = Math.min((now - lastTime) / 1000, 0.1);
          lastTime = now;
          offset += speed * dt;

          if (offset >= maxOffset) {
            offset = maxOffset;
            applyFrame();
            // 終端で静止 → ループ再生
            setTimeout(triggerRankingDemo, 1800);
            return;
          }
          applyFrame();
          rankingRAF = requestAnimationFrame(step);
        }

        requestAnimationFrame((now) => {
          lastTime = now;
          rankingRAF = requestAnimationFrame(step);
        });
      }

      // 初回自動実行
      triggerBracketDemo();

      // 更新履歴の「さらに表示」
      const btnMore = document.getElementById('btn-show-more');
      if (btnMore) {
        btnMore.addEventListener('click', () => {
          const hiddenItems = document.querySelectorAll('.update-list .update-item.is-hidden');
          hiddenItems.forEach(item => {
            item.classList.remove('is-hidden');
          });
          btnMore.style.display = 'none';
        });
      }
    });
  </script>
</BaseLayout>
