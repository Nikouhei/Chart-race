{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chartrace",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  // 配信するのは npm run build の出力（dist/）。Cloudflare 側のビルドコマンドは npm run build
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
